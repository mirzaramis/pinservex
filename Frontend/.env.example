# Copy to .env.local and fill in. Restart the Vite dev server after changes.

# Cloudflare Turnstile PUBLIC site key (safe to expose in the browser).
# Leave blank to disable the captcha.
VITE_TURNSTILE_SITE_KEY=

# Only needed if the API is hosted on a different origin than the SPA.
# VITE_API_URL=https://api.example.com
